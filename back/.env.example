# ===== 服务端 =====
PORT=3000
NODE_ENV=production

# CORS 允许的前端域名，逗号分隔（留空 = 允许所有）
ALLOWED_ORIGINS=

# ===== MySQL 数据库 =====
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=my_website

# ===== JWT 密钥（务必更换为随机字符串） =====
JWT_SECRET=
REFRESH_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=7d

# ===== bcrypt =====
BCRYPT_SALT_ROUNDS=10

# ===== 站点信息（RSS 等） =====
SITE_URL=http://localhost
SITE_TITLE=Danica
SITE_DESCRIPTION=个人博客
